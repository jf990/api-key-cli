{
    "name": "api-key-cli",
    "version": "1.2.1",
    "description": "CLI app to provide various helpers for working with ArcGIS API keys",
    "main": "source/index.js",
    "type": "module",
    "bin": {
        "api-key-cli": "source/index.js",
        "api-key-helper": "source/index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jf990/api-key-cli.git"
    },
    "bugs": {
        "url": "https://github.com/jf990/api-key-cli/issues"
    },
    "homepage": "https://github.com/jf990/api-key-cli#readme",
