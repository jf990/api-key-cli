        "chalk": "^6.0.0",
        "dotenv": "^17.4.2",
        "esm": "^3.2.25",
        "fs-extra": "^11.4.0",
        "path": "^0.12.7",
        "yaml": "^2.9.1",
        "yargs": "^18.1.0"
    },
